# Development settings. Change every secret before internet-facing deployment.
POSTGRES_DB=dacsan
POSTGRES_USER=dacsan
POSTGRES_PASSWORD=local_dev_password_change_me
DATABASE_URL=postgresql+psycopg://dacsan:local_dev_password_change_me@postgres:5432/dacsan
SECRET_KEY=local_development_only_replace_with_64_random_chars
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeMe123!
MEDIA_ROOT=/app/media
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
COOKIE_SECURE=false
# Browser-facing API/media URLs. Same-origin paths work on localhost, an IP or any domain, because the
# nginx proxy (default http://localhost:8080) serves the site, /api and /media together.
# Baked in at frontend BUILD time: after changing them run `docker compose up -d --build`.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_MEDIA_BASE_URL=/media
# Proxy listen address. For a test server reachable directly over HTTP use PROXY_BIND=0.0.0.0 and set
# COOKIE_SECURE=false (admin login cookie). Behind HTTPS (tunnel / TLS proxy) use COOKIE_SECURE=true.
# PROXY_BIND=127.0.0.1
# PROXY_PORT=8080
SERVER_API_BASE_URL=http://backend:8000/api/v1
