# Sao chép thành .env rồi sửa. ĐỔI các giá trị mật khẩu/secret trước khi đưa lên server thật.
POSTGRES_USER=dacsan
POSTGRES_PASSWORD=dacsan
POSTGRES_DB=dacsan

JWT_SECRET=doi-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# true = nạp dữ liệu mẫu (số 17 và các số cũ) khi DB trống; production nên để false
SEED_DEMO=true

WEB_PORT=3000
BACKEND_PORT=8000

# Lấy IP thật của người dùng từ X-Forwarded-For do reverse proxy (nginx/Caddy) ghi. Không có reverse proxy: 0
FORWARDED_HOPS=1

# Email (SMTP). Để trống SMTP_HOST thì email chỉ lưu ở admin › Hộp thư đi, không gửi đi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (cổng 587) | ssl (cổng 465) | none
SMTP_SECURITY=starttls
# Địa chỉ website công khai, dùng tạo link trong email (đặt lại mật khẩu, xác nhận/hủy đăng ký nhận tin)
SITE_URL=http://localhost:3000

# Sao lưu hằng ngày (DB + media + bản thảo) vào volume backups
BACKUP_AT=02:00
BACKUP_KEEP=14
TZ=Asia/Ho_Chi_Minh

# Quét mã độc tệp tải lên bằng ClamAV. Máy dev: chạy `docker compose --profile scan up -d` rồi đặt CLAMAV_HOST=clamav.
CLAMAV_HOST=
# false = máy quét lỗi/chưa sẵn sàng thì từ chối tệp (an toàn); true = vẫn nhận tệp
CLAMAV_FAIL_OPEN=false
