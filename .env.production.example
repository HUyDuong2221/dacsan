# Copy to .env.production and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32

# Public domain whose DNS A record points at this server (ports 80 and 443 must be open).
DOMAIN=dacsan.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# --- TEST SERVER over plain HTTP (no TLS), e.g. http://203.0.113.10:8080 -----------------------------
# DOMAIN=203.0.113.10          # the server IP or hostname people type in the browser
# SITE_ADDRESS=http://203.0.113.10
# HTTP_PORT=8080               # use 80 if free
# APP_ENV=staging              # relaxes the production-only startup checks
# COOKIE_SECURE=false          # required for admin login over http://
# Keep secrets strong anyway. Switch back to APP_ENV=production + a real domain with HTTPS for go-live.
# ---------------------------------------------------------------------------------------------------

# Host ports for Caddy (defaults 80 / 443). Change them if something else already uses those ports.
#   - Router/firewall forwards public 80/443 -> these ports: automatic HTTPS keeps working.
#   - Public traffic reaches Caddy through ANOTHER proxy or a tunnel (Cloudflare Tunnel, Traefik, nginx):
#     set SITE_ADDRESS=http://<your domain> so Caddy serves plain HTTP (TLS is handled by that proxy)
#     and point the proxy/tunnel at http://localhost:<HTTP_PORT>.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SITE_ADDRESS=http://dacsan.example.com

POSTGRES_DB=dacsan
POSTGRES_USER=dacsan
POSTGRES_PASSWORD=

# At least 32 random characters. Changing it logs everyone out.
SECRET_KEY=

# First administrator, created on first start only if no admin exists yet.
# Changing these later does NOT change an existing account's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

BACKUP_KEEP_DAYS=14
